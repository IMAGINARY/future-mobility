{
  "patterns": [
    {
      "from": "**",
      "to": "../vendor/jquery/",
      "context": "node_modules/jquery/dist"
    },
    {
      "from": "**",
      "to": "../vendor/bootstrap/",
      "context": "node_modules/bootstrap/dist"
    },
    {
      "from": "**",
      "to": "../vendor/popper.js/",
      "context": "node_modules/@popperjs/core/dist"
    },
    {
      "from": "**",
      "to": "../vendor/chart.js/",
      "context": "node_modules/chart.js/dist"
    },
    {
      "from": "**",
      "to": "../vendor/pixi.js/",
      "context": "node_modules/pixi.js/dist"
    },
    {
      "from": "**",
      "to": "../vendor/pixi.js@assets/",
      "context": "node_modules/@pixi/assets/dist"
    },
    {
      "from": "textures",
      "to": "../textures"
    },
    {
      "from": "static",
      "to": "../static"
    },
    {
      "from": "data",
      "to": "../data"
    },
    {
      "from": "config",
      "to": "../config"
    }
  ]
}
